@startuml SSD_UC1_StartNewMatch
title UC1: Start New Match
actor Player
participant "Game Manager" as System

Player -> System: selectNewGame()
activate System
System -> System: checkSavedArena()

alt Saved Arena Exists
    System --> Player: showDeckBuilder(cards)
    ...Deck Building Process...
    Player -> System: confirmDeck(selectedCards)
    System -> System: validateDeck(selectedCards)
    System -> System: initializeMatch()
    System --> Player: matchStarted()
else No Saved Arena (Extension 2a)
    System --> Player: showMessage("Create Arena First")
    System --> Player: showMainMenu()
end
deactivate System
@enduml

@startuml SSD_UC2_BuildDeck
title UC2: Build Deck
actor Player
participant "Game Manager" as System

activate System
System --> Player: displayLibraryAndSlots()

loop until 8 slots filled
    Player -> System: selectCard(cardID)
    alt Card Unique
        System --> Player: addCardToSlot(cardID)
    else Duplicate Card (Extension)
        System --> Player: ignoreSelection()
    end
end

Player -> System: confirmDeck()
alt Count == 8
    System -> System: saveDeck()
else Count < 8 (Extension 5a)
    System --> Player: showError("Need 8 cards")
end
deactivate System
@enduml

@startuml SSD_UC3_DesignArena
title UC3: Design Arena
actor Player
participant "Game Manager" as System

Player -> System: openArenaEditor()
activate System
System --> Player: displayArenaGrid()

loop placing buildings
    Player -> System: placeStructure(type, position)
    alt Position Valid
        System --> Player: updateGrid(structure)
    else Invalid Position (Extension 5a)
        System --> Player: showFeedback("Invalid Placement")
    end
end

Player -> System: saveLayout()
System -> System: validateLayout()
alt Layout Valid
    System -> System: persistArenaData()
    System --> Player: showSuccess("Arena Saved")
else Missing Towers/Bridges (Extension 6a)
    System --> Player: showError("Invalid Layout")
end
deactivate System
@enduml

@startuml SSD_UC4_DeployCard
title UC4: Deploy Card
actor Player
participant "Game Manager" as System

Player -> System: deployCard(cardID, position)
activate System

System -> System: checkElixirAndValidity(cardID, position)
alt Sufficient Elixir & Valid Position
    System -> System: deductElixir(cost)
    System -> System: spawnEntity(cardID, position)
    System -> System: drawNextCard()
    System --> Player: updateBattleState()
else Insufficient Elixir (Extension 3a)
    System --> Player: showWarning("Not Enough Elixir")
else Invalid Tile (Extension 3b)
    System --> Player: showWarning("Invalid Position")
end
deactivate System
@enduml

@startuml SSD_UC5_MoveTroop
title UC5: Move Troop
actor Troop
participant "Game Manager" as System

activate System
Troop -> System: requestNearestTarget()
System --> Troop: returnTaget(targetID, position)

alt Target Found
    Troop -> System: moveTowards(targetPosition)
    System -> System: updateTroopPosition()
else No Target
    Troop -> System: moveForward()
    System -> System: updateTroopPosition()
end

alt New Enemy Appears (Extension a)
    System -> Troop: notifyNewTarget(enemyID)
    Troop -> System: retarget(enemyID)
end
deactivate System
@enduml

@startuml SSD_UC6_CombatSystem
title UC6: Combat System
actor Unit
participant "Game Manager" as System

activate System
System -> Unit: notifyEnemyInRange(targetID)
Unit -> System: attack(targetID)
System -> System: applyDamage(damageAmount)
System -> System: updateHealth(targetID)

alt Target HP <= 0
    System -> System: destroyUnit(targetID)
    System --> Unit: notifyTargetDestroyed()
else Target Moves Away (Extension 7a)
    System --> Unit: notifyTargetOutOfRange()
    Unit -> System: resumeMovement()
end
deactivate System
@enduml

@startuml SSD_UC7_WinMatch
title UC7: Win Match
actor Player
participant "Game Manager" as System

activate System
System -> System: detectKingTowerDestruction()

alt Opponent King Tower Destroyed
    System -> System: endMatch(Winner=Player)
    System --> Player: showVictoryScreen()
else Player King Tower Destroyed (Extension 2b)
    System -> System: endMatch(Winner=Opponent)
    System --> Player: showDefeatScreen()
end
deactivate System
@enduml

@startuml SSD_UC8_MatchTimeout
title UC8: Determine Match Outcome
actor Player
participant "Game Manager" as System

activate System
System -> System: timerExpires()
System -> System: compareCrowns()

alt Player Crowns > Opponent Crowns
    System -> System: declareWinner(Player)
    System --> Player: showVictoryResult()
else Crowns Equal (Extension 2a)
    System -> System: startSuddenDeath()
    opt Sudden Death Timeout
        System -> System: declareDraw()
        System --> Player: showDrawResult()
    end
end
deactivate System
@enduml

@startuml SSD_UC9_ReloadMatch
title UC9: Reload Match
actor Player
participant "Game Manager" as System

Player -> System: selectResumeGame()
activate System
System -> System: fetchSavedGames()
System --> Player: displaySavedGamesList()
Player -> System: selectSaveFile(fileID)

alt File Valid
    System -> System: loadGameState(fileID)
    System --> Player: resumeMatchGameplay()
else File Corrupt/Missing (Extension 2a)
    System --> Player: showError("Load Failed")
    System --> Player: returnToMainMenu()
end
deactivate System
@enduml

@startuml SSD_UC10_SaveMatch
title UC10: Save Match
actor Player
participant "Game Manager" as System

Player -> System: pauseGame()
activate System
System --> Player: showPauseMenu()

Player -> System: selectSaveMatch()
alt Match Active
    System -> System: serializeGameState()
    System -> System: writeToStorage()
    System --> Player: showMessage("Saved Successfully")
else Match Already Ended (Extension a)
    System --> Player: showError("Cannot Save Ended Match")
end
deactivate System
@enduml
