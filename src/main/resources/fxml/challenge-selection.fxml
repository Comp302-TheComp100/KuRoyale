<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Line?>
<?import javafx.geometry.Insets?>

<!-- StackPane wrapper allows dialog overlays -->
<StackPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.kuroyale.controller.ChallengeSelectionController"
           prefWidth="1280" prefHeight="720">
           
    <AnchorPane fx:id="root"
                prefWidth="1280" prefHeight="720">

        <!-- Main Content VBox -->
        <VBox alignment="TOP_CENTER" spacing="30"
              AnchorPane.topAnchor="30.0"
              AnchorPane.bottomAnchor="80.0"
              AnchorPane.leftAnchor="0.0"
              AnchorPane.rightAnchor="0.0">
            
            <!-- Title -->
            <VBox alignment="CENTER" spacing="10">
                <Label fx:id="titleLabel" text="CHALLENGES" styleClass="title-label"/>
                <Label text="Complete challenges in order to unlock the next!" styleClass="challenge-subtitle"/>
            </VBox>

            <!-- Challenge Ladder Container -->
            <ScrollPane fx:id="challengeScrollPane"
                        fitToWidth="true"
                        styleClass="scroll-pane-transparent"
                        VBox.vgrow="ALWAYS">
                <VBox.margin>
                    <Insets left="200" right="200"/>
                </VBox.margin>
                <VBox fx:id="challengeLadderContainer" alignment="CENTER" spacing="0">
                    <padding>
                        <Insets top="20" right="20" bottom="20" left="20"/>
                    </padding>
                    <!-- Challenge cards will be added programmatically -->
                </VBox>
            </ScrollPane>
        </VBox>

        <!-- Back Button -->
        <Button fx:id="backButton"
                text="BACK"
                onAction="#handleBack"
                styleClass="back-button"
                AnchorPane.bottomAnchor="20.0"
                AnchorPane.leftAnchor="30.0"/>

    </AnchorPane>
</StackPane>
