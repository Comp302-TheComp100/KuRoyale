<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.geometry.Insets?>

<AnchorPane fx:id="root" xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.kuroyale.controller.QuestAchievementController"
            styleClass="main-menu-background">

    <!-- Header -->
    <HBox alignment="CENTER" spacing="20"
          AnchorPane.topAnchor="20.0"
          AnchorPane.leftAnchor="20.0"
          AnchorPane.rightAnchor="20.0">
        
        <Button fx:id="backButton" text="BACK" onAction="#handleBack"
                styleClass="menu-button-small"/>
        
        <Label fx:id="titleLabel" text="QUESTS &amp; ACHIEVEMENTS" styleClass="title-label"/>
        
        <!-- Spacer -->
        <HBox HBox.hgrow="ALWAYS"/>
    </HBox>

    <!-- Tab Pane -->
    <TabPane fx:id="tabPane" tabClosingPolicy="UNAVAILABLE"
             AnchorPane.topAnchor="100.0"
             AnchorPane.bottomAnchor="20.0"
             AnchorPane.leftAnchor="50.0"
             AnchorPane.rightAnchor="50.0">
        
        <!-- Daily Quests Tab -->
        <Tab text="Daily Quests" closable="false">
            <VBox fx:id="questsContainer" spacing="20" alignment="TOP_CENTER">
                <padding>
                    <Insets top="30" right="30" bottom="30" left="30"/>
                </padding>
                
                <!-- Timer Display -->
                <HBox alignment="CENTER" spacing="10">
                    <Label text="Resets in:" styleClass="quest-timer-label"/>
                    <Label fx:id="resetTimerLabel" text="23:59:59" styleClass="quest-timer-value"/>
                </HBox>
                
                <!-- Quest Cards Container -->
                <VBox fx:id="questCardsContainer" spacing="15" alignment="CENTER">
                    <!-- Quests will be added dynamically -->
                </VBox>
            </VBox>
        </Tab>
        
        <!-- Achievements Tab -->
        <Tab text="Achievements" closable="false">
            <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="NEVER" styleClass="achievement-scroll scroll-pane-transparent"
                        style="-fx-background: transparent; -fx-background-color: transparent; -fx-control-inner-background: transparent;">
                <VBox fx:id="achievementsContainer" spacing="15" alignment="TOP_CENTER">
                    <padding>
                        <Insets top="30" right="30" bottom="30" left="30"/>
                    </padding>
                    <!-- Achievements will be added dynamically -->
                </VBox>
            </ScrollPane>
        </Tab>
    </TabPane>

</AnchorPane>
