<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>

<StackPane fx:id="root" xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.kuroyale.controller.SettingsController"
           styleClass="main-menu-background">

    <VBox alignment="CENTER" spacing="40" maxWidth="600" style="-fx-background-color: rgba(0, 0, 0, 0.7); -fx-background-radius: 20; -fx-padding: 40;">
        
        <Label text="SETTINGS" style="-fx-font-family: 'Clash Regular'; -fx-font-size: 48px; -fx-text-fill: white; -fx-effect: dropshadow(three-pass-box, black, 10, 0, 0, 0);"/>
        
        <VBox spacing="10" alignment="CENTER">
            <Label text="MUSIC VOLUME" style="-fx-font-family: 'Clash Regular'; -fx-font-size: 24px; -fx-text-fill: white;"/>
            <Slider fx:id="musicSlider" min="0" max="1" value="0.5" maxWidth="400"/>
        </VBox>
        
        <VBox spacing="10" alignment="CENTER">
            <Label text="SFX VOLUME" style="-fx-font-family: 'Clash Regular'; -fx-font-size: 24px; -fx-text-fill: white;"/>
            <Slider fx:id="sfxSlider" min="0" max="1" value="0.5" maxWidth="400"/>
        </VBox>

        <CheckBox fx:id="buttonSoundsCheckBox" text="ENABLE BUTTON SOUNDS" style="-fx-font-family: 'Clash Regular'; -fx-font-size: 18px; -fx-text-fill: white;" selected="true"/>
        
        <Button fx:id="backButton" text="BACK" onAction="#handleBack" 
                styleClass="menu-button" prefWidth="200" prefHeight="50"/>
        
    </VBox>

</StackPane>
