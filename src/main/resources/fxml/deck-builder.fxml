<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<StackPane fx:id="rootPane" xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.kuroyale.controller.DeckBuilderController"
           prefWidth="1280" prefHeight="720">
    
    <AnchorPane prefWidth="1280" prefHeight="720">
        
        <!-- Battle Deck Title - Centered -->
        <!-- Battle Deck Title - Left Side Vertical -->
        <VBox layoutX="50" layoutY="50" spacing="-5" alignment="CENTER_LEFT">
            <Label text="BATTLE" styleClass="battle-deck-title-label" style="-fx-font-size: 44px;"/>
            <Label fx:id="battleDeckTitle" text="DECK" styleClass="battle-deck-title-label" style="-fx-font-size: 44px;"/>
        </VBox>
        
        <!-- Deck Slots Background Area - shows empty rectangles -->
        <AnchorPane fx:id="deckSlotsBackground" 
                    layoutX="330" layoutY="30"
                    prefWidth="620" prefHeight="340">
            
            <!-- Average Elixir Cost Display - Centered inside brown area at bottom -->
            <HBox fx:id="averageElixirContainer" 
                  layoutY="300" 
                  spacing="5" 
                  alignment="CENTER">
                <Label text="Average Elixir cost:"/>
                <Label fx:id="averageElixirValue" text="0.0"/>
                <ImageView fitWidth="25" fitHeight="25" preserveRatio="true">
                    <image>
                        <Image url="@/images/card_elixir.png"/>
                    </image>
                </ImageView>
            </HBox>
        </AnchorPane>
        
        <!-- Deck Slots Container - transparent, slots positioned individually, moved down -->
        <AnchorPane fx:id="deckSlotsContainer" 
              layoutX="330" layoutY="50"
              prefWidth="620" prefHeight="280"
              style="-fx-background-color: transparent;">
        </AnchorPane>
        
        <!-- Cards Grid Background - fixed brown background -->
        <AnchorPane fx:id="cardsGridBackground" 
                   layoutX="330" layoutY="390"
                   prefWidth="620" prefHeight="300">
        </AnchorPane>
        
        <!-- Random Deck Button - positioned bottom-right of deck area -->
        <ImageView fx:id="randomDeckButton"
                   layoutX="845" layoutY="315"
                   fitWidth="110" fitHeight="80"
                   preserveRatio="true"
                   pickOnBounds="true"
                   onMouseClicked="#handleRandomDeck">
            <image>
                <Image url="@../images/random_deck_button.png"/>
            </image>
        </ImageView>
        
        <!-- Cards Grid Area - transparent scroll pane, only cards scroll -->
        <ScrollPane fx:id="cardsScrollPane" 
                   layoutX="0" layoutY="390"
                   prefWidth="1280" prefHeight="300"
                   fitToWidth="true">
            <VBox alignment="CENTER" style="-fx-background-color: transparent; -fx-padding: 20;">
                <GridPane fx:id="cardsGrid" alignment="CENTER"/>
            </VBox>
        </ScrollPane>
        
        <!-- Combo Panel - Right side -->
        <VBox fx:id="comboPanel" 
              layoutX="960" layoutY="70"
              prefWidth="300" prefHeight="340"
              spacing="10"
              style="-fx-background-color: rgba(50, 35, 25, 0.95); -fx-background-radius: 15; -fx-padding: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.5), 10, 0.3, 0, 3);">
            <Label text="Available Combos" 
                   style="-fx-text-fill: #f7b32b; -fx-font-size: 18px; -fx-font-weight: bold; -fx-effect: dropshadow(gaussian, rgba(247,179,43,0.4), 3, 0.5, 0, 0);"/>
            <ScrollPane fx:id="comboScrollPane" 
                        prefHeight="290" 
                        fitToWidth="true"
                        hbarPolicy="NEVER"
                        vbarPolicy="NEVER"
                        styleClass="scroll-pane-transparent"
                        style="-fx-background: transparent; -fx-background-color: transparent;">
                <VBox fx:id="comboList" spacing="10" style="-fx-padding: 5;"/>
            </ScrollPane>
        </VBox>
        
        <!-- Back Button -->
        <Button fx:id="backButton" 
                layoutX="50" layoutY="670"
                text="BACK" 
                onAction="#handleBack"/>
    </AnchorPane>
    
</StackPane>

