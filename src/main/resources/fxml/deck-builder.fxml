<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<StackPane fx:id="rootPane" xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.kuroyale.controller.DeckBuilderController"
           prefWidth="1280" prefHeight="720">
    
    <AnchorPane prefWidth="1280" prefHeight="720" styleClass="deck-builder-main-background">
        
        <!-- Battle Deck Title - Centered -->
        <HBox fx:id="battleDeckTitleContainer" 
              layoutY="30"
              alignment="CENTER"
              prefWidth="1280">
            <Label fx:id="battleDeckTitle" text="Battle Deck" styleClass="battle-deck-title"/>
        </HBox>
        
        <!-- Deck Slots Background Area - shows empty rectangles -->
        <AnchorPane fx:id="deckSlotsBackground" 
                    layoutX="240" layoutY="70"
                    prefWidth="800" prefHeight="420"
                    styleClass="deck-slots-background">
            
            <!-- Average Elixir Cost Display - Centered inside brown area at bottom -->
            <HBox fx:id="averageElixirContainer" 
                  layoutY="380" 
                  spacing="5" 
                  alignment="CENTER"
                  styleClass="average-elixir-container">
                <Label text="Average Elixir cost:" styleClass="average-elixir-label"/>
                <Label fx:id="averageElixirValue" text="0.0" styleClass="average-elixir-value"/>
                <ImageView fitWidth="25" fitHeight="25" preserveRatio="true">
                    <image>
                        <Image url="@/images/card_elixir.png"/>
                    </image>
                </ImageView>
            </HBox>
        </AnchorPane>
        
        <!-- Deck Slots Container - transparent, slots positioned individually, moved down -->
        <AnchorPane fx:id="deckSlotsContainer" 
              layoutX="240" layoutY="90"
              prefWidth="800" prefHeight="360"
              style="-fx-background-color: transparent;">
        </AnchorPane>
        
        <!-- Cards Grid Area - main menu background with brown box for cards -->
        <ScrollPane fx:id="cardsScrollPane" 
                   layoutX="0" layoutY="540"
                   prefWidth="1280" prefHeight="180"
                   fitToWidth="true" 
                   styleClass="cards-scroll-pane">
            <VBox alignment="CENTER" styleClass="cards-container-wrapper">
                <GridPane fx:id="cardsGrid" styleClass="cards-grid" alignment="CENTER"/>
            </VBox>
        </ScrollPane>
        
        <!-- Back Button -->
        <Button fx:id="backButton" 
                layoutX="50" layoutY="670"
                text="BACK" 
                onAction="#handleBack"
                styleClass="back-button"/>
    </AnchorPane>
    
</StackPane>

