<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!-- PvP Battle Layout: P1 hand left, Arena center, P2 hand right, Time/Score far right -->
<StackPane xmlns="http://javafx.com/javafx/21"
    xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.kuroyale.controller.PvPBattleController" stylesheets="@../styles/application.css">

    <!-- Background -->
    <AnchorPane styleClass="main-background">
        <BorderPane AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">

            <!-- Left: Player 1 Elixir and Hand -->
            <left>
                <VBox fx:id="player1Container" spacing="20" alignment="CENTER" style="-fx-padding: 20; -fx-background-color: rgba(30, 60, 120, 0.4);">
                    <!-- Player 1 Elixir Bar -->
                    <HBox fx:id="player1ElixirContainer" alignment="CENTER">
                        <!-- ElixirBar added dynamically -->
                    </HBox>

                    <!-- Player 1 Hand -->
                    <VBox fx:id="player1HandContainer" alignment="CENTER" spacing="10">
                        <!-- HandView added dynamically -->
                    </VBox>

                    <Button text="Pause" onAction="#handlePause" styleClass="menu-button-small"/>
                    <Button text="Exit Battle" onAction="#handleExit" styleClass="menu-button-small"/>
                </VBox>
            </left>

            <!-- Center: Arena -->
            <center>
                <StackPane fx:id="arenaContainer" style="-fx-padding: 20;">
                    <!-- Arena View will be added here dynamically -->
                </StackPane>
            </center>

            <!-- Right: Player 2 Elixir and Hand (switched with Time/Score per user request) -->
            <right>
                <HBox spacing="0" alignment="CENTER" fillHeight="false">
                    <!-- Player 2 Panel - mirrors P1 layout -->
                    <VBox fx:id="player2Container" spacing="20" alignment="CENTER" style="-fx-padding: 20; -fx-background-color: rgba(120, 30, 30, 0.4);">
                        <!-- Player 2 Elixir Bar -->
                        <HBox fx:id="player2ElixirContainer" alignment="CENTER">
                            <!-- ElixirBar added dynamically -->
                        </HBox>

                        <!-- Player 2 Hand -->
                        <VBox fx:id="player2HandContainer" alignment="CENTER" spacing="10">
                            <!-- HandView added dynamically -->
                        </VBox>

                        <!-- End Turn Button for PvP -->
                        <Button fx:id="endTurnButton" text="END TURN" onAction="#handleEndTurn" styleClass="menu-button-gold" prefWidth="150"/>
                    </VBox>

                    <!-- Time and Score Panel (Far Right) -->
                    <VBox fx:id="infoPanel" spacing="20" alignment="CENTER" prefWidth="280" style="-fx-padding: 20; -fx-background-color: rgba(0,0,0,0.5);">
                        <Label text="TIME" style="-fx-text-fill: white; -fx-font-size: 14px;"/>
                        <Label fx:id="timeLabel" text="03:00" style="-fx-text-fill: white; -fx-font-size: 32px; -fx-font-weight: bold;"/>

                        <Label text="SCORE" style="-fx-text-fill: white; -fx-font-size: 14px;"/>
                        
                        <HBox alignment="CENTER" spacing="20">
                             <VBox alignment="CENTER" spacing="5">
                                 <Label text="P1" style="-fx-text-fill: #3b82f6; -fx-font-size: 12px;"/>
                                 <HBox fx:id="player1ScoreContainer" alignment="CENTER" spacing="2" minHeight="30" minWidth="60"/>
                             </VBox>
                             <Label text="-" style="-fx-text-fill: white; -fx-font-size: 20px;"/>
                             <VBox alignment="CENTER" spacing="5">
                                 <Label text="P2" style="-fx-text-fill: #ef4444; -fx-font-size: 12px;"/>
                                 <HBox fx:id="player2ScoreContainer" alignment="CENTER" spacing="2" minHeight="30" minWidth="60"/>
                             </VBox>
                        </HBox>

                        <!-- Turn Indicator -->
                        <VBox alignment="CENTER" spacing="5" style="-fx-padding: 15; -fx-background-color: rgba(0,0,0,0.3); -fx-background-radius: 10;">
                            <Label fx:id="turnIndicatorLabel" text="P1 TURN" style="-fx-text-fill: #3b82f6; -fx-font-size: 20px; -fx-font-weight: bold;"/>
                            <Label fx:id="turnArrowLabel" text="◀" style="-fx-text-fill: #3b82f6; -fx-font-size: 24px;"/>
                        </VBox>
                    </VBox>
                </HBox>
            </right>

        </BorderPane>
    </AnchorPane>

    <!-- Pause Menu Overlay -->
    <VBox fx:id="pauseMenuContainer" alignment="CENTER" visible="false" style="-fx-background-color: rgba(0,0,0,0.8);">
    </VBox>

    <!-- Game Over Overlay -->
    <VBox fx:id="gameOverRoot" alignment="CENTER" visible="false" spacing="20" maxWidth="500" maxHeight="500" styleClass="game-over-popup" style="-fx-background-color: black;">
        <Label fx:id="gameOverTitle" text="PLAYER 1 WINS!" styleClass="game-over-title"/>
        <HBox alignment="CENTER" spacing="40">
            <VBox alignment="CENTER" spacing="10">
                <Label text="PLAYER 1" style="-fx-text-fill: #3b82f6; -fx-font-size: 24px; -fx-font-weight: bold;"/>
                <HBox fx:id="gameOverP1Crowns" alignment="CENTER" spacing="5" minHeight="70"/>
            </VBox>
            <Label text="-" style="-fx-text-fill: white; -fx-font-size: 48px; -fx-font-weight: bold;"/>
            <VBox alignment="CENTER" spacing="10">
                <Label text="PLAYER 2" style="-fx-text-fill: #ef4444; -fx-font-size: 24px; -fx-font-weight: bold;"/>
                <HBox fx:id="gameOverP2Crowns" alignment="CENTER" spacing="5" minHeight="70"/>
            </VBox>
        </HBox>

        <Label fx:id="gameOverInfoLabel" text="Combos: 0" style="-fx-text-fill: white; -fx-font-size: 24px; -fx-text-alignment: center; -fx-font-weight: bold;" wrapText="true"/>
        <Button text="RETURN TO MENU" onAction="#handleExit" styleClass="menu-button-gold"/>
    </VBox>

</StackPane>
