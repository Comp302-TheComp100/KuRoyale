<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.geometry.Insets?>

<AnchorPane fx:id="root" xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.kuroyale.controller.LoginController"
            styleClass="login-background"
            style="-fx-background-image: url('@../images/login_background.jpg'); -fx-background-size: cover; -fx-background-position: center;">
    
    <!-- Title at Top -->
    <Label fx:id="titleLabel" text="KU ROYALE" 
           styleClass="title-label"
           AnchorPane.topAnchor="60.0"
           AnchorPane.leftAnchor="0.0"
           AnchorPane.rightAnchor="0.0"
           alignment="CENTER"/>
    
    <!-- Center Content - Login/Create Account Buttons -->
    <VBox fx:id="buttonContainer" alignment="CENTER" spacing="20"
          AnchorPane.topAnchor="250.0"
          AnchorPane.bottomAnchor="150.0"
          AnchorPane.leftAnchor="300.0"
          AnchorPane.rightAnchor="300.0">
        
        <Button fx:id="loginButton"
                text="LOGIN" 
                onAction="#handleLoginClick"
                styleClass="login-button"
                prefWidth="300"
                prefHeight="70"/>
        
        <Button fx:id="createAccountButton"
                text="CREATE ACCOUNT" 
                onAction="#handleCreateAccountClick"
                styleClass="login-button"
                prefWidth="300"
                prefHeight="70"/>
    </VBox>
    
    <!-- Login Form (Initially Hidden) -->
    <VBox fx:id="loginForm" alignment="CENTER" spacing="15" visible="false"
          AnchorPane.topAnchor="250.0"
          AnchorPane.leftAnchor="300.0"
          AnchorPane.rightAnchor="300.0"
          style="-fx-background-color: rgba(0, 0, 0, 0.7); -fx-background-radius: 20; -fx-padding: 30;">
        
        <Label text="LOGIN" 
               style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-font-family: 'Clash', Arial; -fx-text-fill: white;"/>
        
        <TextField fx:id="usernameField" 
                   promptText="Username"
                   prefWidth="280"
                   prefHeight="50"
                   style="-fx-font-size: 18px;"/>
        
        <PasswordField fx:id="passwordField" 
                       promptText="Password"
                       prefWidth="280"
                       prefHeight="50"
                       style="-fx-font-size: 18px;"/>
        
        <Label fx:id="errorLabel" 
               text=""
               visible="false"
               wrapText="true"
               prefWidth="280"
               style="-fx-text-fill: #ff6b6b; -fx-font-size: 14px;"/>
        
        <Button text="SUBMIT" 
                onAction="#handleLogin"
                styleClass="login-button"
                prefWidth="280"
                prefHeight="60"/>
        
        <Button text="BACK" 
                onAction="#handleBack"
                styleClass="back-button"
                prefWidth="280"
                prefHeight="50"/>
    </VBox>
    
    <!-- Create Account Form (Initially Hidden) -->
    <VBox fx:id="createAccountForm" alignment="CENTER" spacing="15" visible="false"
          AnchorPane.topAnchor="250.0"
          AnchorPane.leftAnchor="300.0"
          AnchorPane.rightAnchor="300.0"
          style="-fx-background-color: rgba(0, 0, 0, 0.7); -fx-background-radius: 20; -fx-padding: 30;">
        
        <Label text="CREATE ACCOUNT" 
               style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-font-family: 'Clash', Arial; -fx-text-fill: white;"/>
        
        <TextField fx:id="newUsernameField" 
                   promptText="Username"
                   prefWidth="280"
                   prefHeight="50"
                   style="-fx-font-size: 18px;"/>
        
        <PasswordField fx:id="newPasswordField" 
                       promptText="Password"
                       prefWidth="280"
                       prefHeight="50"
                       style="-fx-font-size: 18px;"/>
        
        <Label fx:id="createErrorLabel" 
               text=""
               visible="false"
               wrapText="true"
               prefWidth="280"
               style="-fx-text-fill: #ff6b6b; -fx-font-size: 14px;"/>
        
        <Button text="CREATE" 
                onAction="#handleCreateAccount"
                styleClass="login-button"
                prefWidth="280"
                prefHeight="60"/>
        
        <Button text="BACK" 
                onAction="#handleBack"
                styleClass="back-button"
                prefWidth="280"
                prefHeight="50"/>
    </VBox>
    
    <!-- Tips & Tricks at Bottom (Black Bar Area) -->
    <Label text="TIPS &amp; TRICKS: NERF GERCEKASLAN"
           AnchorPane.bottomAnchor="30.0"
           AnchorPane.leftAnchor="0.0"
           AnchorPane.rightAnchor="0.0"
           alignment="CENTER"
           style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-font-family: 'Clash', Arial; -fx-text-fill: white; -fx-effect: dropshadow(gaussian, rgba(0, 0, 0, 0.8), 5, 0, 0, 2);"/>
    
</AnchorPane>
