<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.geometry.Insets?>

<AnchorPane fx:id="root"
    xmlns="http://javafx.com/javafx"
    xmlns:fx="http://javafx.com/fxml" fx:controller="com.kuroyale.controller.PvPDeckSelectionController" prefWidth="1280" prefHeight="720">

    <!-- Title -->
    <VBox alignment="CENTER" spacing="10" AnchorPane.topAnchor="30.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">
        <Label fx:id="titleLabel" text="SELECT YOUR DECKS" styleClass="title-label"/>
        <Label text="Both players must select their battle deck" styleClass="subtitle-label"/>
    </VBox>

    <!-- Main Content - Two Player Panels -->
    <HBox spacing="50" alignment="CENTER" AnchorPane.topAnchor="120.0" AnchorPane.bottomAnchor="100.0" AnchorPane.leftAnchor="50.0" AnchorPane.rightAnchor="50.0">

        <!-- Player 1 Panel -->
        <VBox fx:id="player1Panel" alignment="CENTER" spacing="20" styleClass="player-panel" style="-fx-background-color: rgba(30, 100, 200, 0.3); -fx-background-radius: 15; -fx-padding: 20;">
            <Label text="PLAYER 1" styleClass="player-title" style="-fx-text-fill: #3b82f6; -fx-font-size: 28px; -fx-font-weight: bold;"/>

            <!-- Deck Selection -->
            <VBox alignment="CENTER" spacing="10">
                <Label text="Select Deck:" styleClass="deck-label"/>
                <ComboBox fx:id="player1DeckCombo" prefWidth="200" styleClass="deck-combo"/>
            </VBox>

            <!-- Deck Preview Grid -->
            <VBox alignment="CENTER" spacing="10">
                <Label text="Deck Preview:" styleClass="deck-label"/>
                <GridPane fx:id="player1DeckGrid" alignment="CENTER" hgap="5" vgap="5" style="-fx-background-color: rgba(0,0,0,0.3); -fx-padding: 10; -fx-background-radius: 10;">
                    <!-- Cards will be added dynamically -->
                </GridPane>
            </VBox>

            <!-- Ready Indicator -->
            <Label fx:id="player1ReadyLabel" text="NOT READY" style="-fx-text-fill: #ef4444; -fx-font-weight: bold;"/>
        </VBox>

        <!-- VS Divider -->
        <VBox alignment="CENTER">
            <Label text="VS" style="-fx-font-size: 48px; -fx-font-weight: bold; -fx-text-fill: white;"/>
        </VBox>

        <!-- Player 2 Panel -->
        <VBox fx:id="player2Panel" alignment="CENTER" spacing="20" styleClass="player-panel" style="-fx-background-color: rgba(200, 30, 30, 0.3); -fx-background-radius: 15; -fx-padding: 20;">
            <Label text="PLAYER 2" styleClass="player-title" style="-fx-text-fill: #ef4444; -fx-font-size: 28px; -fx-font-weight: bold;"/>

            <!-- Deck Selection -->
            <VBox alignment="CENTER" spacing="10">
                <Label text="Select Deck:" styleClass="deck-label"/>
                <ComboBox fx:id="player2DeckCombo" prefWidth="200" styleClass="deck-combo"/>
            </VBox>

            <!-- Deck Preview Grid -->
            <VBox alignment="CENTER" spacing="10">
                <Label text="Deck Preview:" styleClass="deck-label"/>
                <GridPane fx:id="player2DeckGrid" alignment="CENTER" hgap="5" vgap="5" style="-fx-background-color: rgba(0,0,0,0.3); -fx-padding: 10; -fx-background-radius: 10;">
                    <!-- Cards will be added dynamically -->
                </GridPane>
            </VBox>

            <!-- Ready Indicator -->
            <Label fx:id="player2ReadyLabel" text="NOT READY" style="-fx-text-fill: #ef4444; -fx-font-weight: bold;"/>
        </VBox>
    </HBox>

    <!-- Bottom Buttons -->
    <HBox alignment="CENTER" spacing="200" AnchorPane.bottomAnchor="30.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">

        <Button fx:id="backButton" text="BACK" onAction="#handleBack" styleClass="back-button"/>

        <Button fx:id="startBattleButton" text="START BATTLE" onAction="#handleStartBattle" styleClass="menu-button-gold" prefWidth="200" prefHeight="50"/>
    </HBox>

</AnchorPane>
