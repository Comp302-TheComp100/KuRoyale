<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane fx:id="root" style="-fx-background-color: black;"
    xmlns="http://javafx.com/javafx"
    xmlns:fx="http://javafx.com/fxml" fx:controller="com.kuroyale.controller.PvPDeckSelectionController" prefWidth="1280" prefHeight="720">

    <!-- Title -->
    <VBox alignment="CENTER" spacing="10" AnchorPane.topAnchor="20.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">
        <Label fx:id="titleLabel" text="SELECT YOUR DECKS" styleClass="title-label"/>
        <Label text="Both players must select their battle deck" styleClass="subtitle-label"/>
    </VBox>

    <!-- Main Content - Two Player Panels -->
    <HBox spacing="40" alignment="CENTER" AnchorPane.topAnchor="100.0" AnchorPane.bottomAnchor="90.0" AnchorPane.leftAnchor="50.0" AnchorPane.rightAnchor="50.0">

        <!-- Player 1 Panel -->
        <VBox fx:id="player1Panel" alignment="TOP_CENTER" spacing="15" styleClass="player-panel" style="-fx-background-color: rgba(30, 100, 200, 0.3); -fx-background-radius: 15; -fx-padding: 20;" prefWidth="480" HBox.hgrow="ALWAYS">
            <Label text="PLAYER 1" style="-fx-text-fill: #3b82f6; -fx-font-size: 28px; -fx-font-weight: bold;"/>

            <!-- Deck Selection Dropdown -->
            <HBox alignment="CENTER" spacing="15">
                <Label text="Deck Source:" style="-fx-text-fill: white; -fx-font-size: 16px;"/>
                <ComboBox fx:id="player1DeckCombo" prefWidth="160" styleClass="deck-combo"/>
            </HBox>

            <!-- BUILD Button (shown when Build Deck selected) -->
            <Button fx:id="player1BuildButton" text="BUILD DECK" onAction="#handlePlayer1Build" styleClass="menu-button-gold" prefWidth="180" prefHeight="45"/>

            <!-- RANDOMIZE Button (shown when Random Deck selected) -->
            <Button fx:id="player1RandomizeButton" text="🎲 RANDOMIZE" onAction="#handlePlayer1Randomize" styleClass="menu-button" prefWidth="180" prefHeight="45" visible="false" managed="false"/>

            <!-- Deck Preview Grid -->
            <VBox fx:id="player1DeckContainer" alignment="CENTER" spacing="10">
                <Label text="Deck Preview:" style="-fx-text-fill: #aaa; -fx-font-size: 14px;"/>
                <GridPane fx:id="player1DeckGrid" alignment="CENTER" hgap="8" vgap="8" style="-fx-background-color: rgba(0,0,0,0.4); -fx-padding: 15; -fx-background-radius: 10;">
                </GridPane>
            </VBox>

            <!-- Ready Indicator -->
            <Label fx:id="player1ReadyLabel" text="NOT READY" style="-fx-text-fill: #ef4444; -fx-font-weight: bold; -fx-font-size: 18px;"/>
        </VBox>

        <!-- VS Divider -->
        <VBox alignment="CENTER" minWidth="80">
            <Label text="VS" style="-fx-font-size: 48px; -fx-font-weight: bold; -fx-text-fill: white;"/>
        </VBox>

        <!-- Player 2 Panel -->
        <VBox fx:id="player2Panel" alignment="TOP_CENTER" spacing="15" styleClass="player-panel" style="-fx-background-color: rgba(200, 30, 30, 0.3); -fx-background-radius: 15; -fx-padding: 20;" prefWidth="480" HBox.hgrow="ALWAYS">
            <Label text="PLAYER 2" style="-fx-text-fill: #ef4444; -fx-font-size: 28px; -fx-font-weight: bold;"/>

            <!-- Deck Selection Dropdown -->
            <HBox alignment="CENTER" spacing="15">
                <Label text="Deck Source:" style="-fx-text-fill: white; -fx-font-size: 16px;"/>
                <ComboBox fx:id="player2DeckCombo" prefWidth="160" styleClass="deck-combo"/>
            </HBox>

            <!-- BUILD Button (shown when Build Deck selected) -->
            <Button fx:id="player2BuildButton" text="BUILD DECK" onAction="#handlePlayer2Build" styleClass="menu-button-gold" prefWidth="180" prefHeight="45"/>

            <!-- RANDOMIZE Button (shown when Random Deck selected) -->
            <Button fx:id="player2RandomizeButton" text="🎲 RANDOMIZE" onAction="#handlePlayer2Randomize" styleClass="menu-button" prefWidth="180" prefHeight="45" visible="false" managed="false"/>

            <!-- Deck Preview Grid -->
            <VBox fx:id="player2DeckContainer" alignment="CENTER" spacing="10">
                <Label text="Deck Preview:" style="-fx-text-fill: #aaa; -fx-font-size: 14px;"/>
                <GridPane fx:id="player2DeckGrid" alignment="CENTER" hgap="8" vgap="8" style="-fx-background-color: rgba(0,0,0,0.4); -fx-padding: 15; -fx-background-radius: 10;">
                </GridPane>
            </VBox>

            <!-- Ready Indicator -->
            <Label fx:id="player2ReadyLabel" text="NOT READY" style="-fx-text-fill: #ef4444; -fx-font-weight: bold; -fx-font-size: 18px;"/>
        </VBox>
    </HBox>

    <!-- Bottom Buttons -->
    <HBox alignment="CENTER" spacing="250" AnchorPane.bottomAnchor="25.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">
        <Button fx:id="backButton" text="BACK" onAction="#handleBack" styleClass="back-button"/>
        <Button fx:id="startBattleButton" text="START BATTLE" onAction="#handleStartBattle" styleClass="menu-button-gold" prefWidth="220" prefHeight="55"/>
    </HBox>

</AnchorPane>
