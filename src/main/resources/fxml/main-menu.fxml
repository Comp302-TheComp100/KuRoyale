<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.shape.Circle?>

<AnchorPane fx:id="root" xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.kuroyale.controller.MainMenuController"
            styleClass="main-menu-background">

    <!-- Top Resource Bar -->
    <HBox spacing="20" alignment="CENTER"
          AnchorPane.topAnchor="20.0"
          AnchorPane.leftAnchor="20.0"
          AnchorPane.rightAnchor="20.0">
        
        <!-- Profile Button -->
        <Button fx:id="profileButton"
                onAction="#handleProfile"
                style="-fx-background-color: rgba(0, 0, 0, 0.5); -fx-background-radius: 50; -fx-pref-width: 50; -fx-pref-height: 50;">
            <graphic>
                <ImageView fitHeight="35.0" fitWidth="35.0" pickOnBounds="true" preserveRatio="true">
                    <image>
                        <Image url="@../images/user_profile.png"/>
                    </image>
                    <clip>
                        <Circle centerX="17.5" centerY="17.5" radius="17.5"/>
                    </clip>
                </ImageView>
            </graphic>
        </Button>
        
        <!-- Spacer -->
        <HBox HBox.hgrow="ALWAYS"/>
        
        <!-- Settings Button -->
        <Button fx:id="settingsButton"
                onAction="#handleSettings"
                style="-fx-background-color: rgba(0, 0, 0, 0.5); -fx-background-radius: 50; -fx-pref-width: 50; -fx-pref-height: 50;">
            <graphic>
                <ImageView fitHeight="35.0" fitWidth="35.0" pickOnBounds="true" preserveRatio="true">
                    <image>
                        <Image url="@../images/settings_icon.png"/>
                    </image>
                </ImageView>
            </graphic>
        </Button>

        <!-- Quit Button -->
        <Button fx:id="quitButton"
                text="QUIT"
                onAction="#handleQuit"
                style="-fx-background-color: rgba(239, 68, 68, 0.9); -fx-text-fill: white; -fx-font-weight: bold; -fx-font-family: 'Clash', Arial; -fx-background-radius: 20; -fx-padding: 8 20; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(0, 0, 0, 0.5), 5, 0, 0, 1);">
        </Button>
    </HBox>

    <!-- Title at Top Center -->
    <Label fx:id="titleLabel" text="KU ROYALE" 
           styleClass="title-label"
           AnchorPane.topAnchor="80.0"
           AnchorPane.leftAnchor="0.0"
           AnchorPane.rightAnchor="0.0"
           alignment="CENTER"/>

    <!-- Left Side - Challenge and Quest Icons -->
    <VBox spacing="50" alignment="TOP_LEFT"
          AnchorPane.topAnchor="200.0"
          AnchorPane.leftAnchor="10.0">
        
        <!-- Challenge -->
        <HBox spacing="10" alignment="CENTER_LEFT">
            <Button fx:id="challengesButton"
                    onAction="#handleChallenges"
                    style="-fx-background-color: transparent; -fx-border-width: 0; -fx-pref-width: 100; -fx-pref-height: 100; -fx-cursor: hand;">
                <graphic>
                    <ImageView fitHeight="100.0" fitWidth="100.0" pickOnBounds="true" preserveRatio="true">
                        <image>
                            <Image url="@../images/challenge_icon.png"/>
                        </image>
                    </ImageView>
                </graphic>
            </Button>
            
            <Label text="CHALLENGES"
                   style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-font-family: 'Clash', Arial; -fx-text-fill: white; -fx-effect: dropshadow(gaussian, rgba(0, 0, 0, 0.7), 5, 0, 0, 2);"/>
        </HBox>
        
        <!-- Quest and Achievements -->
        <HBox spacing="10" alignment="CENTER">
            <Button fx:id="questsButton"
                    onAction="#handleQuests"
                    style="-fx-background-color: transparent; -fx-border-width: 0; -fx-pref-width: 100; -fx-pref-height: 100; -fx-cursor: hand;">
                <graphic>
                    <ImageView fitHeight="100.0" fitWidth="100.0" pickOnBounds="true" preserveRatio="true">
                        <image>
                            <Image url="@../images/quest_icon.png"/>
                        </image>
                    </ImageView>
                </graphic>
            </Button>
            
            <Label text="QUEST &amp; ACHIEVEMENTS"
                   style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-font-family: 'Clash', Arial; -fx-text-fill: white; -fx-effect: dropshadow(gaussian, rgba(0, 0, 0, 0.7), 5, 0, 0, 2);"/>
        </HBox>
    </VBox>

    <!-- Right Side Save/Load Section -->
    <HBox spacing="10" alignment="CENTER_RIGHT"
          AnchorPane.topAnchor="250.0"
          AnchorPane.rightAnchor="20.0">
        
        <Label text="SAVE &amp; LOAD"
               style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-font-family: 'Clash', Arial; -fx-text-fill: white; -fx-effect: dropshadow(gaussian, rgba(0, 0, 0, 0.7), 5, 0, 0, 2);"/>
        
        <Button fx:id="resumeGameButton"
                onAction="#handleResumeGame"
                style="-fx-background-color: transparent; -fx-border-width: 0; -fx-background-radius: 0; -fx-pref-width: 95; -fx-pref-height: 95; -fx-font-size: 0;">
            <graphic>
                <ImageView fitHeight="140.0" fitWidth="140.0" pickOnBounds="true" preserveRatio="true">
                    <image>
                        <Image url="@../images/save_load_icon.png"/>
                    </image>
                </ImageView>
            </graphic>
        </Button>
    </HBox>

    <!-- Central Large Arena Design Button -->
    <Button fx:id="arenaDesignButton"
            onAction="#handleArenaDesign"
            AnchorPane.topAnchor="180.0"
            AnchorPane.bottomAnchor="180.0"
            AnchorPane.leftAnchor="250.0"
            AnchorPane.rightAnchor="250.0"
            style="-fx-background-color: transparent; -fx-border-width: 0; -fx-cursor: hand; -fx-padding: 0;">
        <graphic>
            <ImageView fitHeight="300.0" fitWidth="300.0" pickOnBounds="true" preserveRatio="true">
                <image>
                    <Image url="@../images/arena_icon.png"/>
                </image>
            </ImageView>
        </graphic>
    </Button>

    <!-- Bottom Buttons - Battle and Deck Builder Side by Side -->
    <HBox spacing="15" alignment="CENTER"
          AnchorPane.bottomAnchor="40.0"
          AnchorPane.leftAnchor="180.0"
          AnchorPane.rightAnchor="180.0">
        
        <!-- Battle Button (Left) -->
        <Button fx:id="startMatchButton"
                text="BATTLE" 
                onAction="#handleStartMatch"
                styleClass="menu-button"
                prefHeight="75"
                prefWidth="220"
                style="-fx-font-size: 28px; -fx-background-radius: 20;">
            <graphic>
                <ImageView fitHeight="45.0" fitWidth="45.0" pickOnBounds="true" preserveRatio="true">
                    <image>
                        <Image url="@../images/battle_icon.png"/>
                    </image>
                </ImageView>
            </graphic>
        </Button>
        
        <!-- Deck Builder Button (Right) - moved from left side -->
        <Button fx:id="deckBuilderButton"
                text="DECK" 
                onAction="#handleDeckBuilder"
                styleClass="menu-button"
                prefHeight="75"
                prefWidth="220"
                style="-fx-font-size: 28px; -fx-background-radius: 20;">
            <graphic>
                <ImageView fitHeight="45.0" fitWidth="45.0" pickOnBounds="true" preserveRatio="true">
                    <image>
                        <Image url="@../images/deck_icon.png"/>
                    </image>
                </ImageView>
            </graphic>
        </Button>
    </HBox>
    
</AnchorPane>
