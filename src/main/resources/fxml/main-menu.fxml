<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.shape.Circle?>

<AnchorPane fx:id="root" xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.kuroyale.controller.MainMenuController"
            styleClass="main-menu-background">

    <!-- Top Resource Bar -->
    <HBox spacing="20" alignment="CENTER"
          AnchorPane.topAnchor="20.0"
          AnchorPane.leftAnchor="20.0"
          AnchorPane.rightAnchor="20.0">
        
        <!-- Gold Display -->
        <HBox fx:id="goldDisplay"
              alignment="CENTER"
              spacing="10"
              style="-fx-background-color: rgba(0, 0, 0, 0.5); -fx-background-radius: 25; -fx-padding: 8 20 8 20;">
            <ImageView fitHeight="30.0" fitWidth="30.0" pickOnBounds="true" preserveRatio="true">
                <image>
                    <Image url="@../images/deck_icon.png"/>
                </image>
            </ImageView>
            <Label fx:id="goldLabel" text="0" styleClass="gold-label" style="-fx-font-size: 24px;"/>
        </HBox>
        
        <!-- Spacer -->
        <HBox HBox.hgrow="ALWAYS"/>
        
        <!-- Settings Button -->
        <Button fx:id="settingsButton"
                onAction="#handleSettings"
                style="-fx-background-color: rgba(0, 0, 0, 0.5); -fx-background-radius: 50; -fx-pref-width: 50; -fx-pref-height: 50;">
            <graphic>
                <ImageView fitHeight="35.0" fitWidth="35.0" pickOnBounds="true" preserveRatio="true">
                    <image>
                        <Image url="@../images/settings_icon.png"/>
                    </image>
                </ImageView>
            </graphic>
        </Button>
    </HBox>

    <!-- Title at Top Center -->
    <Label fx:id="titleLabel" text="KU ROYALE" 
           styleClass="title-label"
           AnchorPane.topAnchor="80.0"
           AnchorPane.leftAnchor="0.0"
           AnchorPane.rightAnchor="0.0"
           alignment="CENTER"/>


    <!-- Right Side Circular Buttons -->
    <VBox spacing="15" alignment="TOP_CENTER"
          AnchorPane.topAnchor="200.0"
          AnchorPane.rightAnchor="20.0">
        
        <Button fx:id="challengesButton"
                onAction="#handleChallenges"
                styleClass="menu-button"
                style="-fx-background-radius: 50; -fx-pref-width: 80; -fx-pref-height: 80; -fx-font-size: 0;">
            <graphic>
                <ImageView fitHeight="50.0" fitWidth="50.0" pickOnBounds="true" preserveRatio="true">
                    <image>
                        <Image url="@../images/battle_icon.png"/>
                    </image>
                </ImageView>
            </graphic>
        </Button>
        
        <Button fx:id="questsButton"
                onAction="#handleQuests"
                styleClass="menu-button"
                style="-fx-background-radius: 50; -fx-pref-width: 80; -fx-pref-height: 80; -fx-font-size: 0;">
            <graphic>
                <ImageView fitHeight="50.0" fitWidth="50.0" pickOnBounds="true" preserveRatio="true">
                    <image>
                        <Image url="@../images/battle_icon.png"/>
                    </image>
                </ImageView>
            </graphic>
        </Button>
        
        <Button fx:id="resumeGameButton"
                onAction="#handleResumeGame"
                styleClass="menu-button"
                style="-fx-background-radius: 50; -fx-pref-width: 80; -fx-pref-height: 80; -fx-font-size: 0;">
            <graphic>
                <ImageView fitHeight="50.0" fitWidth="50.0" pickOnBounds="true" preserveRatio="true">
                    <image>
                        <Image url="@../images/battle_icon.png"/>
                    </image>
                </ImageView>
            </graphic>
        </Button>
    </VBox>

    <!-- Central Large Arena Design Button -->
    <Button fx:id="arenaDesignButton"
            onAction="#handleArenaDesign"
            styleClass="menu-button"
            AnchorPane.topAnchor="200.0"
            AnchorPane.bottomAnchor="200.0"
            AnchorPane.leftAnchor="200.0"
            AnchorPane.rightAnchor="200.0"
            style="-fx-background-radius: 25; -fx-font-size: 0; -fx-background-color: transparent; -fx-border-width: 0;">
        <graphic>
            <ImageView fitHeight="250.0" fitWidth="250.0" pickOnBounds="true" preserveRatio="true">
                <image>
                    <Image url="@../images/arena_icon.png"/>
                </image>
            </ImageView>
        </graphic>
    </Button>

    <!-- Bottom Buttons - Battle and Deck Builder Side by Side -->
    <HBox spacing="15" alignment="CENTER"
          AnchorPane.bottomAnchor="40.0"
          AnchorPane.leftAnchor="180.0"
          AnchorPane.rightAnchor="180.0">
        
        <!-- Battle Button (Left) -->
        <Button fx:id="startMatchButton"
                text="BATTLE" 
                onAction="#handleStartMatch"
                styleClass="menu-button"
                prefHeight="75"
                prefWidth="220"
                style="-fx-font-size: 28px; -fx-background-radius: 20;">
            <graphic>
                <ImageView fitHeight="45.0" fitWidth="45.0" pickOnBounds="true" preserveRatio="true">
                    <image>
                        <Image url="@../images/battle_icon.png"/>
                    </image>
                </ImageView>
            </graphic>
        </Button>
        
        <!-- Deck Builder Button (Right) - moved from left side -->
        <Button fx:id="deckBuilderButton"
                text="DECK" 
                onAction="#handleDeckBuilder"
                styleClass="menu-button"
                prefHeight="75"
                prefWidth="220"
                style="-fx-font-size: 28px; -fx-background-radius: 20;">
            <graphic>
                <ImageView fitHeight="45.0" fitWidth="45.0" pickOnBounds="true" preserveRatio="true">
                    <image>
                        <Image url="@../images/deck_icon.png"/>
                    </image>
                </ImageView>
            </graphic>
        </Button>
    </HBox>
    
</AnchorPane>
