<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" 
           fx:controller="com.kuroyale.controller.NetworkBattleController"
           stylesheets="@../styles/application.css">
    
    <!-- Background -->
    <AnchorPane styleClass="main-background">
        <BorderPane AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" 
                    AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            
            <!-- Left: Elixir, Hand, and Network Status -->
            <left>
                <VBox spacing="15" alignment="CENTER" style="-fx-padding: 20; -fx-background-color: rgba(0,0,0,0.3);">
                    <!-- Connection Status -->
                    <HBox alignment="CENTER" spacing="5">
                        <Circle fx:id="connectionIndicator" radius="6" style="-fx-fill: lime;"/>
                        <Label fx:id="connectionStatusLabel" text="Connected" style="-fx-text-fill: white; -fx-font-size: 12px;"/>
                    </HBox>
                    <Label fx:id="pingLabel" text="Ping: --ms" style="-fx-text-fill: #aaa; -fx-font-size: 10px;"/>
                    
                    <!-- Elixir Bar -->
                    <HBox fx:id="elixirContainer" alignment="CENTER">
                        <!-- ElixirBar added dynamically -->
                    </HBox>
                    
                    <!-- Hand (Vertical for left side) -->
                    <VBox fx:id="handContainer" alignment="CENTER" spacing="10">
                        <!-- HandView added dynamically -->
                    </VBox>
                    
                    <Button text="Pause" onAction="#handlePause" styleClass="menu-button-small"/>
                    <Button text="Exit Battle" onAction="#handleBackToMenu" styleClass="menu-button-small"/>
                </VBox>
            </left>
            
            <!-- Center: Arena -->
            <center>
                <StackPane fx:id="arenaContainer" style="-fx-padding: 20;">
                    <!-- Arena View will be added here dynamically -->
                </StackPane>
            </center>
            
            <!-- Right: Player info and scores -->
            <right>
                <VBox spacing="20" alignment="CENTER" style="-fx-padding: 20; -fx-background-color: rgba(0,0,0,0.3);">
                    <!-- Game Timer -->
                    <VBox alignment="CENTER" spacing="2">
                        <Label text="TIME" style="-fx-text-fill: #888; -fx-font-size: 12px;"/>
                        <Label fx:id="timerLabel" text="3:00" style="-fx-text-fill: white; -fx-font-size: 32px; -fx-font-weight: bold;"/>
                    </VBox>
                    
                    <!-- Your Info -->
                    <VBox alignment="CENTER" spacing="5">
                        <Label fx:id="playerNameLabel" text="You" style="-fx-text-fill: #00aaff; -fx-font-size: 14px; -fx-font-weight: bold;"/>
                        <Label fx:id="playerScoreLabel" text="0" style="-fx-text-fill: white; -fx-font-size: 24px; -fx-font-weight: bold;"/>
                    </VBox>
                    
                    <Label text="VS" style="-fx-text-fill: #888; -fx-font-size: 18px;"/>
                    
                    <!-- Opponent Info -->
                    <VBox alignment="CENTER" spacing="5">
                        <Label fx:id="opponentNameLabel" text="Opponent" style="-fx-text-fill: #ff4444; -fx-font-size: 14px; -fx-font-weight: bold;"/>
                        <Label fx:id="opponentScoreLabel" text="0" style="-fx-text-fill: white; -fx-font-size: 24px; -fx-font-weight: bold;"/>
                    </VBox>
                    
                    <!-- Lag Indicator -->
                    <Label fx:id="lagIndicator" text="⚠ High Latency" style="-fx-text-fill: orange; -fx-font-size: 11px;" visible="false"/>
                </VBox>
            </right>
            
        </BorderPane>
    </AnchorPane>
    
    <!-- Pause Menu Overlay -->
    <VBox fx:id="pauseMenuContainer" alignment="CENTER" visible="false" style="-fx-background-color: rgba(0,0,0,0.8);">
    </VBox>
    
    <!-- Disconnection Overlay -->
    <VBox fx:id="disconnectionOverlay" alignment="CENTER" spacing="20" visible="false" 
          style="-fx-background-color: rgba(0,0,0,0.9);">
        <Label fx:id="disconnectionLabel" text="Opponent Disconnected" 
               style="-fx-text-fill: white; -fx-font-size: 32px; -fx-font-weight: bold;"/>
        <Label fx:id="reconnectingLabel" text="Attempting to reconnect..." 
               style="-fx-text-fill: #aaa; -fx-font-size: 18px;"/>
        <Label fx:id="reconnectCountdownLabel" text="5" 
               style="-fx-text-fill: orange; -fx-font-size: 48px; -fx-font-weight: bold;"/>
    </VBox>
    
    <!-- Game Over Overlay -->
    <VBox fx:id="resultOverlay" alignment="CENTER" visible="false" spacing="20" maxWidth="400" maxHeight="300" styleClass="game-over-popup">
        <Label fx:id="resultLabel" text="VICTORY" styleClass="game-over-title"/>
        <Label fx:id="resultDetailsLabel" text="You destroyed more towers!" styleClass="game-over-score"/>
        <Button text="EXIT" onAction="#handleBackToMenu" styleClass="menu-button-generic"/>
    </VBox>
    
</StackPane>

