<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.shape.Circle?>
<?import javafx.geometry.Insets?>

<AnchorPane fx:id="root" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
    fx:controller="com.kuroyale.controller.NetworkBattleController"
    prefWidth="1280" prefHeight="720" styleClass="battle-background">

    <!-- Top Bar: Timer, Scores, Connection Status -->
    <HBox alignment="CENTER" spacing="50" AnchorPane.topAnchor="10" AnchorPane.leftAnchor="10" AnchorPane.rightAnchor="10">
        
        <!-- Player Score -->
        <VBox alignment="CENTER" spacing="5">
            <Label fx:id="playerNameLabel" text="You" styleClass="player-name-label"/>
            <Label fx:id="playerScoreLabel" text="0" styleClass="score-label"/>
        </VBox>
        
        <!-- Timer and Connection -->
        <VBox alignment="CENTER" spacing="5">
            <Label fx:id="timerLabel" text="3:00" styleClass="timer-label"/>
            <HBox alignment="CENTER" spacing="5">
                <Circle fx:id="connectionIndicator" radius="6" styleClass="status-connected"/>
                <Label fx:id="connectionStatusLabel" text="Connected" styleClass="connection-label"/>
            </HBox>
        </VBox>
        
        <!-- Opponent Score -->
        <VBox alignment="CENTER" spacing="5">
            <Label fx:id="opponentNameLabel" text="Opponent" styleClass="player-name-label"/>
            <Label fx:id="opponentScoreLabel" text="0" styleClass="score-label"/>
        </VBox>
    </HBox>

    <!-- Arena -->
    <Pane fx:id="arenaPane" AnchorPane.topAnchor="80" AnchorPane.bottomAnchor="150" 
          AnchorPane.leftAnchor="200" AnchorPane.rightAnchor="200" styleClass="arena-pane"/>

    <!-- Left Panel: Your Info -->
    <VBox alignment="CENTER" spacing="10" prefWidth="180" 
          AnchorPane.topAnchor="80" AnchorPane.bottomAnchor="150" AnchorPane.leftAnchor="10">
        
        <!-- Elixir Bar -->
        <Label text="Elixir" styleClass="elixir-title"/>
        <ProgressBar fx:id="elixirBar" progress="0.5" prefWidth="150" prefHeight="20" styleClass="elixir-bar"/>
        <Label fx:id="elixirLabel" text="5/10" styleClass="elixir-label"/>
        
        <!-- Pause Button -->
        <Button fx:id="pauseButton" text="PAUSE" onAction="#handlePause" 
                prefWidth="120" prefHeight="40" styleClass="pause-button"/>
    </VBox>

    <!-- Right Panel: Lag Indicator -->
    <VBox alignment="CENTER" spacing="10" prefWidth="180" 
          AnchorPane.topAnchor="80" AnchorPane.bottomAnchor="150" AnchorPane.rightAnchor="10">
        
        <Label text="Network" styleClass="network-title"/>
        <Label fx:id="pingLabel" text="Ping: --ms" styleClass="ping-label"/>
        <Label fx:id="lagIndicator" text="" styleClass="lag-indicator" visible="false"/>
    </VBox>

    <!-- Bottom: Card Hand -->
    <HBox fx:id="cardHandPane" alignment="CENTER" spacing="15" 
          AnchorPane.bottomAnchor="20" AnchorPane.leftAnchor="100" AnchorPane.rightAnchor="100">
        <!-- Cards will be added dynamically -->
    </HBox>

    <!-- Disconnection Overlay (hidden by default) -->
    <VBox fx:id="disconnectionOverlay" alignment="CENTER" spacing="20" 
          visible="false" styleClass="overlay-background"
          AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0" 
          AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0">
        
        <Label fx:id="disconnectionLabel" text="Opponent Disconnected" styleClass="overlay-title"/>
        <Label fx:id="reconnectingLabel" text="Attempting to reconnect..." styleClass="overlay-subtitle"/>
        <Label fx:id="reconnectCountdownLabel" text="5" styleClass="countdown-label"/>
    </VBox>

    <!-- Victory/Defeat Overlay -->
    <VBox fx:id="resultOverlay" alignment="CENTER" spacing="20" 
          visible="false" styleClass="overlay-background"
          AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0" 
          AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0">
        
        <Label fx:id="resultLabel" text="VICTORY!" styleClass="result-label"/>
        <Label fx:id="resultDetailsLabel" text="You destroyed more towers!" styleClass="result-details"/>
        <Button text="BACK TO MENU" onAction="#handleBackToMenu" 
                prefWidth="200" prefHeight="50" styleClass="menu-button"/>
    </VBox>

</AnchorPane>

