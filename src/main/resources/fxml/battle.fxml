<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" 
           fx:controller="com.kuroyale.controller.BattleController"
           stylesheets="@../styles/application.css">
    
    <!-- Background -->
    <AnchorPane styleClass="main-background">
        <BorderPane AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" 
                    AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            
            <!-- Left: Elixir and Hand -->
            <left>
                <VBox spacing="20" alignment="CENTER" prefWidth="300" styleClass="sidebar-panel">
                    <!-- Elixir Bar -->
                    <HBox fx:id="elixirContainer" alignment="CENTER">
                        <!-- ElixirBar added dynamically -->
                    </HBox>
                    
                    <!-- Hand (Vertical for left side) -->
                    <VBox fx:id="handContainer" alignment="CENTER" spacing="10">
                        <!-- HandView added dynamically -->
                    </VBox>
                    
                    <Button text="Pause" onAction="#handlePause" styleClass="menu-button-small"/>
                    <Button text="Exit Battle" onAction="#handleExit" styleClass="menu-button-small"/>
            </VBox>
            </left>
            
            <!-- Center: Arena -->
            <center>
                <StackPane fx:id="arenaContainer" style="-fx-padding: 20;" alignment="CENTER">
                    <!-- Arena View will be added here dynamically -->
                </StackPane>
            </center>
            
            <!-- Right: Timer and Score -->
            <right>
                <VBox fx:id="sidebarContainer" spacing="20" alignment="CENTER" prefWidth="300" styleClass="sidebar-panel">
                    <Label text="TIME" style="-fx-text-fill: white; -fx-font-size: 20px; -fx-font-weight: bold;"/>
                    <Label fx:id="timeLabel" text="03:00" style="-fx-text-fill: white; -fx-font-size: 36px; -fx-font-weight: bold;"/>
                    
                    <Separator/>
                    
                    <Label text="SCORE" style="-fx-text-fill: white; -fx-font-size: 20px; -fx-font-weight: bold;"/>
                    <HBox alignment="CENTER" spacing="10">
                        <VBox alignment="CENTER" spacing="5">
                            <Label text="YOU" style="-fx-text-fill: #3b82f6; -fx-font-size: 18px; -fx-font-weight: bold;"/>
                            <HBox fx:id="playerScoreContainer" alignment="CENTER" spacing="2" minHeight="25" minWidth="50"/>
                        </VBox>
                        <Label text="-" style="-fx-text-fill: white; -fx-font-size: 28px; -fx-font-weight: bold;"/>
                        <VBox alignment="CENTER" spacing="5">
                            <Label text="BOT" style="-fx-text-fill: #ff6b6b; -fx-font-size: 18px; -fx-font-weight: bold;"/>
                            <HBox fx:id="botScoreContainer" alignment="CENTER" spacing="2" minHeight="25" minWidth="50"/>
                        </VBox>
                    </HBox>
                    
                    <Separator/>
                    
                    <Label text="COMBOS" style="-fx-text-fill: gold; -fx-font-size: 20px; -fx-font-weight: bold;"/>
                    <Label fx:id="comboLabel" text="0" style="-fx-text-fill: gold; -fx-font-size: 36px; -fx-font-weight: bold;"/>
                </VBox>
            </right>
            
        </BorderPane>
    </AnchorPane>
    
    <!-- Overlay for Game Over, Pause Menu, etc. -->
    <VBox fx:id="overlayContainer" alignment="CENTER" visible="false" style="-fx-background-color: rgba(0,0,0,0.7);">
        <Label text="GAME OVER" style="-fx-text-fill: white; -fx-font-size: 48px; -fx-font-weight: bold;"/>
        <Button text="Back to Menu" onAction="#handleExit" styleClass="menu-button"/>
    </VBox>
    
    <!-- Pause Menu Overlay -->
    <VBox fx:id="pauseMenuContainer" alignment="CENTER" visible="false" style="-fx-background-color: rgba(0,0,0,0.8);">
    </VBox>

    <!-- Challenge Game Over Overlay -->
    <VBox fx:id="challengeGameOverRoot" alignment="CENTER" visible="false" spacing="15" maxWidth="450" maxHeight="500" styleClass="challenge-popup">
        <Label fx:id="challengeTitle" text="CHALLENGE COMPLETE!" styleClass="challenge-title"/>
        
        <HBox fx:id="challengeStarBox" alignment="CENTER" spacing="5">
            <Label fx:id="star1" text="★" styleClass="challenge-star"/>
            <Label fx:id="star2" text="★" styleClass="challenge-star"/>
            <Label fx:id="star3" text="★" styleClass="challenge-star"/>
        </HBox>
        
        <Label fx:id="challengeTimeLabel" text="Time: 2:45  Damage: 0" styleClass="challenge-text-generic"/>
        
        <VBox fx:id="challengeConditionsBox" alignment="CENTER" spacing="5" style="-fx-background-color: rgba(0,0,0,0.3); -fx-padding: 10; -fx-background-radius: 10;">
            <!-- Conditions added dynamically -->
        </VBox>
        
        <Label fx:id="challengeRewardLabel" text="Reward: 150 Gold" styleClass="challenge-text-generic" wrapText="true" textAlignment="CENTER"/>
        
        <Button text="RETURN TO CHALLENGES" onAction="#handleExitToChallenges" styleClass="menu-button-gold"/>
    </VBox>
    
    <!-- Standard Game Over Overlay -->
    <VBox fx:id="gameOverRoot" alignment="CENTER" visible="false" spacing="20" maxWidth="500" maxHeight="500" styleClass="game-over-popup">
        <Label fx:id="gameOverTitle" text="VICTORY" styleClass="game-over-title"/>
        <HBox alignment="CENTER" spacing="40">
            <VBox alignment="CENTER" spacing="10">
                <Label text="PLAYER" style="-fx-text-fill: #3b82f6; -fx-font-size: 24px; -fx-font-weight: bold;"/>
                <HBox fx:id="gameOverPlayerCrowns" alignment="CENTER" spacing="5" minHeight="70"/>
            </VBox>
            <Label text="-" style="-fx-text-fill: white; -fx-font-size: 48px; -fx-font-weight: bold;"/>
            <VBox alignment="CENTER" spacing="10">
                <Label text="BOT" style="-fx-text-fill: #ff6b6b; -fx-font-size: 24px; -fx-font-weight: bold;"/>
                <HBox fx:id="gameOverBotCrowns" alignment="CENTER" spacing="5" minHeight="70"/>
            </VBox>
        </HBox>

        <Label fx:id="gameOverInfoLabel" text="Combos: 0 (+0 gold)" style="-fx-text-fill: white; -fx-font-size: 24px; -fx-text-alignment: center; -fx-font-weight: bold;" wrapText="true"/>
        <Button text="EXIT" onAction="#handleExit" styleClass="menu-button-generic"/>
    </VBox>
    
</StackPane>
