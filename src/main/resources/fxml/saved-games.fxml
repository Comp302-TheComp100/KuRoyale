<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.geometry.Insets?>

<AnchorPane fx:id="root" xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.kuroyale.controller.SavedGamesController"
            styleClass="main-menu-background">

    <!-- Main Content -->
    <VBox alignment="TOP_CENTER" spacing="30" 
          AnchorPane.topAnchor="50.0" 
          AnchorPane.bottomAnchor="50.0" 
          AnchorPane.leftAnchor="100.0" 
          AnchorPane.rightAnchor="100.0">
        
        <padding>
            <Insets top="20" right="20" bottom="20" left="20"/>
        </padding>
        
        <Label text="SAVED GAMES" styleClass="title-label"/>
        
        <Label fx:id="infoLabel" text="Select a saved game to resume" 
               style="-fx-font-size: 18px; -fx-text-fill: white;"/>
        
        <!-- Saved games list -->
        <ScrollPane fx:id="savedGamesScrollPane" 
                    fitToWidth="true" 
                    prefHeight="400"
                    style="-fx-background: transparent; -fx-background-color: rgba(0,0,0,0.5);">
            <VBox fx:id="savedGamesContainer" spacing="15" style="-fx-padding: 20;">
                <!-- Saved game entries will be added dynamically -->
            </VBox>
        </ScrollPane>
        
        <!-- Back button -->
        <Button text="BACK TO MENU" 
                onAction="#handleBack"
                styleClass="menu-button"
                prefWidth="300"
                prefHeight="60"/>
    </VBox>

</AnchorPane>

